{
	"name": "xuexitong-ai-helper",
	"version": "1.0.2",
	"description": "学习通 AI 辅助插件，支持自定义 AI 接口、自动答题、手动搜题和章节学习。",
	"types": "./lib/src/core/index.d.ts",
	"main": "./lib/src/core/index.js",
	"files": [
		"lib",
		"dist"
	],
	"scripts": {
		"dev": "gulp -f ./scripts/dev-core.js",
		"build": "gulp -f ./scripts/build-core.js",
		"typecheck": "pnpm --filter @xuexitong-ai-helper/utils exec tsc --noEmit && pnpm --filter @xuexitong-ai-helper/core exec tsc --noEmit && pnpm --filter @xuexitong-ai-helper/scripts exec tsc --noEmit",
		"tsc": "gulp -f ./scripts/tsc.js",
		"lint": "pnpm format && eslint  ./packages --ext .ts,.tsx,.js,.jsx --fix",
		"format": "prettier -c ./.prettierrc.json  **/*.ts  **/*.js  **/*.css  --write"
	},
	"devDependencies": {
		"@html-eslint/eslint-plugin": "^0.15.0",
		"@types/node": "^17.0.16",
		"@typescript-eslint/eslint-plugin": "^5.19.0",
		"@typescript-eslint/parser": "^5.19.0",
		"browser-env": "^3.3.0",
		"del": "^6.0.0",
		"eslint": "^7.32.0",
		"eslint-config-prettier": "^8.5.0",
		"eslint-config-standard": "^16.0.3",
		"eslint-plugin-import": "^2.22.1",
		"eslint-plugin-node": "^11.1.0",
		"eslint-plugin-prettier": "^4.0.0",
		"eslint-plugin-promise": "^4.2.1",
		"eslint-plugin-vue": "^9.8.0",
		"gulp": "^4.0.2",
		"gulp-cli": "^2.3.0",
		"prettier": "^2.6.2",
		"typescript": "^4.5.5"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yxxawa/xuexitong-ai-helper.git"
	},
	"keywords": [
		"xuexitong",
		"chaoxing",
		"ai",
		"userscript",
		"script",
		"playwright",
		"puppeteer",
		"electron",
		"vue",
		"ant-design-vue",
		"typescript"
	],
	"author": "enncy / modified",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/yxxawa/xuexitong-ai-helper/issues"
	},
	"homepage": "https://github.com/yxxawa/xuexitong-ai-helper#readme",
	"dependencies": {
		"@microsoft/tsdoc": "^0.14.2"
	}
}
